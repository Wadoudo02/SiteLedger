# Copy to .env and fill in. Never commit real values.
ANTHROPIC_API_KEY=
DATABASE_URL=              # Neon Postgres (added by the Vercel Neon integration)
BLOB_READ_WRITE_TOKEN=     # Vercel Blob store
# Optional
EXTRACTION_MODEL=          # defaults to claude-sonnet-5-5
EXTRACTOR=                 # set to "mock" to use fixed data instead of the API
